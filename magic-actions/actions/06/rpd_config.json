{
  "import": {
    "general": {
      "rotateZUp": false
	},
    "CAD": {
      "tessellationResolution":"fine", 
      "sewTolerance": 0.05, 
      "removeTJunctions": false 
    },
    "discard": {
      "cameras": false,
      "lights": false,
      "animations": false,
      "morphTargets": false,
